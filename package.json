{
	"name": "cvforge",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"description": "CVForge — CV builder with Google OAuth, Google Drive storage, and PDF export",
	"author": "CVForge Team",
	"scripts": {
		"postinstall": "node scripts/copy-pdf-fonts.mjs",
		"pdf-fonts:copy": "node scripts/copy-pdf-fonts.mjs",
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . && prettier --check .",
		"lint:fix": "eslint . --fix && prettier --write .",
		"lint:style": "stylelint --cache \"src/**/*.{css,scss}\" --cache-location node_modules/.cache/stylelint/",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch",
		"test:mutation": "stryker run",
		"type-check": "tsc --noEmit",
		"format": "prettier --write ."
	},

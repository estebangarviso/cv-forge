# Copy to .env.local for local development:
#   cp .env.example .env.local
# On Vercel, set these in Project Settings → Environment Variables instead.

# ─── Auth.js (next-auth v5) ────────────────────────
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-secret-here

# Required. From https://console.cloud.google.com/apis/credentials
# Local redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Access control ────────────────────────────────
# Optional. Comma-separated exact emails and/or @domain.com wildcards.
# Unset means any Google account can sign in.
# ALLOWED_EMAILS=alice@example.com,@company.com

# ─── URLs ──────────────────────────────────────────
# Optional. Absolute base URL used for metadataBase.
# On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL automatically,
# so you only need to set it for a custom domain or non-Vercel hosting.
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── API Configuration ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Optional: private API origin for SSR/edge (never exposed to client)
# INTERNAL_API_URL=http://backend.internal:3001/api

# ─── Application ───────────────────────────────────
NEXT_PUBLIC_APP_NAME=cvforge
NEXT_PUBLIC_APP_ENV=development

# ─── URLs ──────────────────────────────────────────
# Full public URL of the app (used for metadataBase, PWA manifest, OG tags)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── i18n ──────────────────────────────────────────
# Default locale used as fallback when no Accept-Language header matches.
# Supported locales are defined in src/modules/i18n/domain/entities/locale.ts
NEXT_PUBLIC_DEFAULT_LOCALE=es

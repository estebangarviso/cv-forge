coverage/
.reports/

# ─── API generation ────────────────────────────────
# Type definitions generated from the backend OpenAPI spec via `pnpm openapi:gen`.
# Regenerate locally / in CI instead of committing the output.
src/core/api/v1.ts

# ─── PDF fonts ─────────────────────────────────────
# Copied from @fontsource/* packages via `pnpm pdf-fonts:copy` (runs on
# postinstall). Regenerate instead of committing — see
# src/shared/ui/pdf/pdf-fonts.config.mjs.
public/fonts/

# ─── Environment ───────────────────────────────────
.env
.env.local
.env*.local

# ─── IDE ───────────────────────────────────────────
.idea/
*.swp
*.swo

# ─── OS ────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Debug logs ────────────────────────────────────
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Vercel ────────────────────────────────────────
.vercel

# ─── TypeScript ────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
# Local AI runtime state
.atl/
.codegraph/

